#!/usr/bin/env bash
# User-facing PDflow launcher.
#
# The launcher is intentionally small: the installer owns dependencies and
# the application owns the agent lifecycle.  This command only selects the
# already-installed native desktop bundle or the browser development server.
set -Eeuo pipefail

resolve_self() {
  local candidate="${BASH_SOURCE[0]}"
  while [[ -L "${candidate}" ]]; do
    candidate="$(readlink "${candidate}")"
    [[ "${candidate}" = /* ]] || candidate="$(dirname "${BASH_SOURCE[0]}")/${candidate}"
  done
  cd "$(dirname "${candidate}")" && pwd -P
}

SCRIPT_DIR="$(resolve_self)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd -P)"
DATA_ROOT="${XDG_DATA_HOME:-${HOME:-/home/kalishot}/.local/share}"
APP_DIR="${PD_FLOW_APP_DIR:-${DATA_ROOT}/pdflow}"
APPIMAGE="${PD_FLOW_APPIMAGE:-${APP_DIR}/PDflow.AppImage}"
EDA_PREFIX="${PD_FLOW_EDA_PREFIX:-${HOME:-/home/kalishot}/.local/pdflow-eda}"
NODE_VERSION="${PD_FLOW_NODE_VERSION:-20.19.5}"
NODE_CANDIDATES=()

usage() {
  cat <<'EOF'
Usage: pdflow [--desktop|--web|--verify|--help] [application args]

With no option, launch the installed native PDflow desktop application.

Options:
  --desktop       require and launch the native AppImage
  --web           launch the local browser Studio at http://127.0.0.1:43217
  --verify        run the native EDA verification gate through the resource guard
  --help          show this help

Environment:
  PD_FLOW_APPIMAGE, PD_FLOW_APP_DIR, PD_FLOW_REPO_ROOT,
  PD_FLOW_EDA_PREFIX, PD_FLOW_NODE
EOF
}

node_compatible() {
  local node_bin="$1"
  local version major minor
  [[ -x "${node_bin}" ]] || return 1
  version="$(${node_bin} --version 2>/dev/null || true)"
  [[ "${version}" =~ ^v([0-9]+)[.]([0-9]+)[.]([0-9]+)$ ]] || return 1
  major="${BASH_REMATCH[1]}"
  minor="${BASH_REMATCH[2]}"
  (( major >= 20 && major < 23 )) || return 1
  (( major != 20 || minor >= 9 )) || return 1
}

find_node() {
  if [[ -n "${PD_FLOW_NODE:-}" ]] && node_compatible "${PD_FLOW_NODE}"; then
    printf '%s\n' "${PD_FLOW_NODE}"
    return 0
  fi
  NODE_CANDIDATES+=(
    "${DATA_ROOT}/pdflow/node-v${NODE_VERSION}-linux-x64/bin/node"
    "${REPO_ROOT}/studio/node-runtime/node"
  )
  if command -v node >/dev/null 2>&1; then
    NODE_CANDIDATES+=("$(command -v node)")
  fi
  local node_candidate
  for node_candidate in "${NODE_CANDIDATES[@]}"; do
    if node_compatible "${node_candidate}"; then
      printf '%s\n' "${node_candidate}"
      return 0
    fi
  done
  return 1
}

export PD_FLOW_REPO_ROOT="${PD_FLOW_REPO_ROOT:-${REPO_ROOT}}"
export PD_FLOW_EDA_PREFIX="${EDA_PREFIX}"

case "${1:-}" in
  --help|-h)
    usage
    exit 0
    ;;
  --verify)
    shift
    exec "${REPO_ROOT}/scripts/run_resource_job.sh" pdflow-native-check \
      "${REPO_ROOT}/scripts/verify_native_eda.sh" "$@"
    ;;
  --desktop)
    shift
    if [[ ! -x "${APPIMAGE}" ]]; then
      echo "PDflow desktop bundle is not installed: ${APPIMAGE}" >&2
      echo "Run ./install.sh from the PDflow checkout first." >&2
      exit 1
    fi
    exec "${APPIMAGE}" "$@"
    ;;
  --web)
    shift
    ;;
  *)
    if [[ -x "${APPIMAGE}" ]]; then
      exec "${APPIMAGE}" "$@"
    fi
    echo "PDflow desktop bundle not found; falling back to web Studio." >&2
    echo "Install the native desktop bundle with ./install.sh, or use --web explicitly." >&2
    ;;
esac

NODE_BIN="$(find_node || true)"
if [[ -z "${NODE_BIN}" ]]; then
  echo "PDflow web Studio requires native Node.js 20–22 (Node 20.9+)." >&2
  echo "Run ./scripts/install_node_runtime.sh or ./install.sh." >&2
  exit 1
fi
export PD_FLOW_NODE="${NODE_BIN}"
if command -v xdg-open >/dev/null 2>&1; then
  xdg-open "http://127.0.0.1:43217" >/dev/null 2>&1 || true
else
  echo "Open http://127.0.0.1:43217 in a browser." >&2
fi
exec "${REPO_ROOT}/scripts/run_studio.sh" "$@"
