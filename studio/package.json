{
  "name": "studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "scripts": {
    "predev": "node scripts/prepare_monaco_assets.mjs",
    "dev": "next dev --webpack -H 127.0.0.1 -p 43217",
    "prebuild": "node scripts/prepare_monaco_assets.mjs",
    "build": "../scripts/run_resource_job.sh studio-next-build ./node-runtime/node node_modules/next/dist/bin/next build --webpack",
    "prestart": "node scripts/prepare_monaco_assets.mjs",
    "start": "next start -H 127.0.0.1 -p 43217",
    "lint": "eslint .",
    "smoke": "npm run build",
    "agent": "PYTHONPATH=../learn python3 -m pdflow_agent --repo-root ..",
    "desktop:dev": "../scripts/run_resource_job.sh studio-tauri-dev bash -lc 'source ../scripts/native_eda_env.sh && exec cargo tauri dev'",
    "desktop:build": "../scripts/run_resource_job.sh studio-tauri-build bash -lc 'source ../scripts/native_eda_env.sh && exec cargo tauri build'"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.34.0",
    "monaco-editor": "^0.56.0",
    "next": "^16.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
