{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDflow",
  "version": "0.1.0",
  "identifier": "com.pdflow.studio",
  "build": {
    "beforeDevCommand": "./node-runtime/node node_modules/next/dist/bin/next dev --webpack -H 127.0.0.1 -p 43217",
    "beforeBuildCommand": "bash scripts/build_tauri_frontend.sh",
    "devUrl": "http://127.0.0.1:43217",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PDflow · Physical Design Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"],
    "resources": {
      "../.next/standalone": "next-standalone",
      "../node-runtime/node": "node-runtime/node"
    },
    "category": "DeveloperTool",
    "shortDescription": "Local physical-design orchestration studio",
    "longDescription": "PDflow desktop shell for OpenROAD, KLayout and local EDA analysis."
  }
}
