{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdflow.local/schemas/tool-registry.schema.json",
  "title": "PDflow tool registry manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "platform", "default_timeout_seconds", "tools"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "platform": {"const": "linux"},
    "default_timeout_seconds": {"type": "integer", "minimum": 1},
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_id",
          "display_name",
          "capabilities",
          "executable_candidates",
          "version_probe",
          "input_kinds",
          "output_kinds",
          "timeout_seconds",
          "required_dependencies"
        ],
        "properties": {
          "tool_id": {"type": "string", "minLength": 1},
          "display_name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "capabilities": {"type": "array", "items": {"type": "string"}},
          "executable_env": {"type": "array", "items": {"type": "string"}},
          "executable_candidates": {"type": "array", "items": {"type": "string"}},
          "commands": {
            "type": "object",
            "additionalProperties": {"type": "array", "items": {"type": "string"}}
          },
          "version_probe": {"type": "array", "items": {"type": "string"}},
          "version_probe_exit_codes": {
            "type": "array",
            "items": {"type": "integer", "minimum": 0},
            "minItems": 1
          },
          "version_label": {"type": "string", "minLength": 1},
          "launch_profiles": {"type": "array", "items": {"type": "string"}},
          "report_parsers": {"type": "array", "items": {"type": "string"}},
          "status_mapping": {"type": "object", "additionalProperties": {"type": "string"}},
          "input_kinds": {"type": "array", "items": {"type": "string"}},
          "output_kinds": {"type": "array", "items": {"type": "string"}},
          "timeout_seconds": {"type": "integer", "minimum": 1},
          "required_dependencies": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
