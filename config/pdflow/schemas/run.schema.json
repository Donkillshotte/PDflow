{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdflow.local/schemas/run.schema.json",
  "title": "PDflow RunContext",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "surface",
    "design_id",
    "pdk_id",
    "profile",
    "created_at",
    "input_artifacts",
    "tool_versions",
    "status"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "minLength": 8},
    "surface": {"enum": ["product", "flow", "package", "lab", "tools"]},
    "design_id": {"type": "string", "minLength": 1},
    "pdk_id": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "input_artifacts": {"type": "array", "items": {"type": "string"}},
    "tool_versions": {"type": "object"},
    "environment": {"type": "object"},
    "status": {"type": "string", "minLength": 1}
  }
}
