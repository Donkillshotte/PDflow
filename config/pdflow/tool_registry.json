{
  "schema_version": 1,
  "platform": "linux",
  "default_timeout_seconds": 600,
  "tools": [
    {
      "tool_id": "openroad",
      "display_name": "OpenROAD",
      "required": true,
      "description": "Physical design database viewer and batch engine.",
      "version_probe": ["-version"],
      "launch_profiles": ["gui"],
      "report_parsers": [],
      "status_mapping": {"exit_0": "PASS", "missing_dependency": "GAP", "timeout": "FAIL"},
      "capabilities": ["gui", "batch", "inspect", "generate"],
      "executable_env": ["OPENROAD_BIN", "OPENROAD_EXE"],
      "executable_candidates": ["{repo}/tools/native/bin/openroad", "openroad", "{repo}/tools/openroad/bin/openroad"],
      "commands": {
        "gui": ["{executable}", "-gui", "-no_splash", "-db", "{artifact}"],
        "web": ["{executable}", "-no_init", "-no_splash", "-web", "-web_port", "{web_port}", "-db", "{artifact}"]
      },
      "input_kinds": ["odb", "tcl"],
      "output_kinds": ["odb", "def", "gds", "spef"],
      "timeout_seconds": 600,
      "required_dependencies": []
    },
