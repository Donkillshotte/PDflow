VERSION 5.8 ;
# Educational scaled dummy bump for the optional ASAP7 package exercise.
# This is a sidecar package model, not a foundry bump or course signoff input.
# PIN PAD is on M9 (power RDL) and M4 (signal RDL).

UNITS
  DATABASE MICRONS 1000 ;
END UNITS

MACRO DUMMY_BUMP
  CLASS COVER BUMP ;
  ORIGIN 0 0 ;
  SIZE 1.0 BY 1.0 ;
  SYMMETRY X Y R90 ;
  PIN PAD
    DIRECTION INOUT ;
    PORT
      LAYER M9 ;
        RECT 0.0 0.0 1.0 1.0 ;
      LAYER M4 ;
        RECT 0.0 0.0 1.0 1.0 ;
    END
  END PAD
END DUMMY_BUMP

MACRO PKG_PAD
  CLASS CORE ;
  ORIGIN 0 0 ;
  SIZE 0.5 BY 0.5 ;
  SYMMETRY X Y R90 ;
  PIN PAD
    DIRECTION INOUT ;
    PORT
      LAYER M9 ;
        RECT 0.0 0.0 0.5 0.5 ;
      LAYER M4 ;
        RECT 0.0 0.0 0.5 0.5 ;
    END
  END PAD
END PKG_PAD
