{
  "name": "lab_asap7_gcd_compact_pkg",
  "description": "Leftover-named compact chip-package ladder for lab ASAP7. Not C4. Not Touchstone. Not a product win. Vdd is ASAP7 TC (0.70 V), not Nangate 1.1 V.",
  "surface": "lab",
  "platform": "asap7",
  "product_win": false,
  "comparison_scope": "ASAP7 compact package model; compare only within this invocation",
  "vdd": 0.70,
  "package_interface": {
    "bump_array": {
      "master": "DUMMY_BUMP",
      "rows": 4,
      "columns": 4,
      "origin_um": [0.8, 0.8],
      "pitch_um": [1.8, 1.8],
      "power_layer": "M9",
      "signal_layer": "M9"
    },
    "power_nets": ["VDD"],
    "ground_nets": ["VSS"],
    "signal_nets": ["clk", "reset", "req_val", "resp_val"],
    "bump_map": [
      {"instance": "BUMP_0_0", "net": "VDD", "class": "power", "role": "supply"},
      {"instance": "BUMP_0_1", "net": "VSS", "class": "ground", "role": "return"},
      {"instance": "BUMP_0_3", "net": "clk", "class": "signal", "role": "clock"},
      {"instance": "BUMP_1_3", "net": "reset", "class": "signal", "role": "control"},
      {"instance": "BUMP_2_3", "net": "req_val", "class": "signal", "role": "request"},
      {"instance": "BUMP_3_3", "net": "resp_val", "class": "signal", "role": "response"}
    ]
  },
  "vrm": {
    "v_nom": 0.70,
    "r_out": 0.020,
    "l_out": 1.5e-9,
    "c_out": 10.0e-6,
    "esr_cout": 0.010
  },
  "board": {
    "r_plane": 0.008,
    "l_plane": 0.8e-9,
    "c_bulk": 4.7e-6,
    "esr_bulk": 0.015,
    "c_hf": 220.0e-9,
    "esr_hf": 0.025,
    "l_via_to_pkg": 0.4e-9
  },
  "package": {
    "r_pkg": 0.05,
    "l_pkg": 0.25e-9,
    "c_pkg": 40.0e-12,
    "n_bumps": 4,
    "r_bump": 0.008,
    "l_bump": 0.04e-9
  },
  "die": {
    "c_die": 20.0e-15,
    "comment": "Educational lump for an ~9 µm ASAP7 gcd die. I_die comes from live finish power / Vdd."
  },
  "ac": {
    "f_start": 1.0e3,
    "f_stop": 1.0e9,
    "points_per_decade": 20,
    "z_target_mohm": 80
  },
  "tran": {
    "t_step": 0.1e-9,
    "t_stop": 200e-9,
    "i_idle_factor": 0.3,
    "i_peak_factor": 4.0,
    "edge_ns": 2.0
  },
  "leftover": {
    "c4": "dummy 4×4 bump LEF, not JEDEC C4",
    "touchstone": "lumped RLC only; no board S-parameter",
    "cpa": "compact ladder, not Ansys CPA / foundry package model"
  }
}
